        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph LR\n    %% Стили компонентов\n    classDef uiStyle fill:#4A154B,stroke:#FFFFFF,stroke-width:1.5px,color:#FFFFFF;\n    classDef coreStyle fill:#003366,stroke:#FFFFFF,stroke-width:1.5px,color:#FFFFFF;\n    classDef mediaStyle fill:#4A0000,stroke:#FFFFFF,stroke-width:1.5px,color:#FFFFFF;\n    classDef dbStyle fill:#0E4D20,stroke:#FFFFFF,stroke-width:1.5px,color:#FFFFFF;\n    classDef redisStyle fill:#555500,stroke:#FFFFFF,stroke-width:1.5px,color:#FFFFFF;\n    classDef extStyle fill:#222222,stroke:#888888,stroke-width:1px,stroke-dasharray: 5 5,color:#FFFFFF;\n\n    UI[\&quot;&lt;b&gt;Web UI Client&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Фронтенд SPA)&lt;/i&gt;&lt;br/&gt;&lt;small&gt;Отв: Разработчик А&lt;/small&gt;\&quot;]\n    Core[\&quot;&lt;b&gt;Core Service&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Backend Монолит)&lt;/i&gt;&lt;br/&gt;&lt;small&gt;Отв: Разработчик Б&lt;/small&gt;\&quot;]\n    Media[\&quot;&lt;b&gt;Media &amp; Chat Engine&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(WebSocket / WebRTC)&lt;/i&gt;&lt;br/&gt;&lt;small&gt;Отв: Разработчик В&lt;/small&gt;\&quot;]\n    DB[(\&quot;&lt;b&gt;PostgreSQL DB&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Реляционная БД)&lt;/i&gt;\&quot;)]\n    Redis[(\&quot;&lt;b&gt;Redis Cache / S3&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(In-Memory / Файлы)&lt;/i&gt;\&quot;)]\n    Payment[\&quot;«external»&lt;br/&gt;&lt;b&gt;Payment Gateway&lt;/b&gt;\&quot;]\n\n    class UI uiStyle;\n    class Core coreStyle;\n    class Media mediaStyle;\n    class DB dbStyle;\n    class Redis redisStyle;\n    class Payment extStyle;\n\n    UI --&gt;|REST / HTTPS| Core\n    UI --&gt;|WSS / WebRTC| Media\n    Core --&gt;|SQL| DB\n    Media --&gt;|In-Memory API| Redis\n    Core -.-&gt;|HTTPS API| Payment&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="EA3Sx3-I8AgjRm1lExX5-21">
